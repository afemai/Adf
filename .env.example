# Production database (Neon Postgres serverless). Not required for local dev —
# without it the site runs on a local JSON file store (data/site_data.json).
DATABASE_URL=

# Vercel Blob token for admin media uploads (production).
BLOB_READ_WRITE_TOKEN=

# Initial admin password used only when the database is first seeded.
# CHANGE IT after first login via /admin/settings.
ADMIN_INITIAL_PASSWORD=Afemhai2026!

# Public site URL (used for sitemap/canonicals; set at deploy time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000